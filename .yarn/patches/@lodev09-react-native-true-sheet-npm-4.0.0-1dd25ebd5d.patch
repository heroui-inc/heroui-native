+    val coordinator = coordinatorLayout ?: return
+    val root = coordinator.parent as? ViewGroup ?: return
+    val effect = if (radius >= 0.5f) RenderEffect.createBlurEffect(radius, radius, Shader.TileMode.CLAMP) else null
